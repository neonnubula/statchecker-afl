# URL of the StatChecker AFL backend (FastAPI). Local default shown.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Shared secret between this frontend's server proxy and the backend.
# Required: at least 32 characters. Generate one with: openssl rand -hex 32
# Use the same value as INTERNAL_API_SECRET in backend/.env.
INTERNAL_API_SECRET=

# Optional per-minute request throttles for the built-in proxy.
# SEARCH_RATE_LIMIT_PER_MINUTE=60
# DETAIL_RATE_LIMIT_PER_MINUTE=120

# Optional comma-separated player names shown as "Top picks" before a visitor types.
# NEXT_PUBLIC_FEATURED_PLAYERS=
