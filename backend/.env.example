# API-Sports AFL key (https://api-sports.io/). Used only by the data-loading scripts.
AFL_API_KEY=

# SQLite database path. Defaults to backend/database/afl_stats.db.
# DB_PATH=/data/afl_stats.db

# Shared secret the frontend proxy sends with research requests.
# Generate with: openssl rand -hex 32. Use the same value in frontend/.env.local.
INTERNAL_API_SECRET=
# Set to true when deployed so a missing secret blocks research instead of opening it.
# REQUIRE_INTERNAL_SECRET=true

# Comma-separated browser origins allowed to call the API directly.
ALLOWED_ORIGINS=http://localhost:3000

# Identify yourself to the free Squiggle schedule API (include contact details).
# SCHEDULE_USER_AGENT=my-statchecker-fork (you@example.com)

# Optional: email a summary after scripts/auto_update_round.py runs (via Resend).
# RESEND_API_KEY=
# NOTIFY_EMAIL=
